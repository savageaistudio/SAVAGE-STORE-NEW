{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Clothing and merchandise item catalog entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 250 },
        "sku": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 10000 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "categoryId": { "type": "string", "maxLength": 100 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "subcategory": { "type": "string", "maxLength": 100 },
        "brand": { "type": "string", "maxLength": 100 },
        "gender": { "type": "string", "enum": ["Men", "Women", "Unisex", "Kids"] },
        "fabric": { "type": "string", "maxLength": 200 },
        "images": { "type": "array" },
        "thumbnail": { "type": "string" },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "variants": { "type": "array" },
        "totalStock": { "type": "number" },
        "tags": { "type": "array" },
        "featured": { "type": "boolean" },
        "newArrival": { "type": "boolean" },
        "bestSeller": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "price", "active"]
    },
    "Category": {
      "title": "Category",
      "description": "Clothing category taxonomy item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "image": { "type": "string" },
        "sortOrder": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "slug", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "shippingAddress": { "type": "string", "maxLength": 500 },
        "division": { "type": "string", "maxLength": 60 },
        "district": { "type": "string", "maxLength": 60 },
        "upazila": { "type": "string", "maxLength": 60 },
        "customerNote": { "type": "string", "maxLength": 500 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 50 },
        "deliveryCharge": { "type": "number" },
        "deliveryZoneName": { "type": "string", "maxLength": 100 },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Cash on Delivery", "Online Payment"] },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Paid", "Refunded", "Failed"] },
        "orderStatus": { "type": "string", "enum": ["Pending", "Confirmed", "Processing", "Packed", "Shipped", "Delivered", "Cancelled", "Returned"] },
        "internalNote": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerName", "customerPhone", "shippingAddress", "items", "totalAmount", "orderStatus"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount promotion coupon",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 30 },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "discountAmount": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "expiryDate": { "type": "string" },
        "usageLimit": { "type": "number" },
        "usedCount": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "code", "discountType", "discountAmount", "active"]
    },
    "DeliveryZone": {
      "title": "DeliveryZone",
      "description": "Shipping rate configuration by geographic region",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "deliveryCharge": { "type": "number" },
        "minimumOrder": { "type": "number" },
        "estimatedDays": { "type": "string", "maxLength": 50 },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "deliveryCharge", "active"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Homepage promotional carousel slide",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "image": { "type": "string" },
        "buttonText": { "type": "string", "maxLength": 50 },
        "buttonLink": { "type": "string", "maxLength": 200 },
        "sortOrder": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "title", "image", "active"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product feedback rating and comment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "approved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "customerName", "rating", "comment", "approved"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Store contact and global parameters",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "description": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "whatsapp": { "type": "string" },
        "facebook": { "type": "string" },
        "instagram": { "type": "string" },
        "tiktok": { "type": "string" },
        "youtube": { "type": "string" },
        "deliveryArea": { "type": "string" },
        "currency": { "type": "string" },
        "announcement": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Store clothing and merchandise catalog items"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Taxonomy categories for filtering"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer purchases with line items and status tracking"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional discount codes"
    },
    "/deliveryZones/{zoneId}": {
      "schema": { "$ref": "#/entities/DeliveryZone" },
      "description": "Shipping regions and fees"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Hero banner slides"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product reviews"
    },
    "/settings/{docId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Store configuration document"
    }
  }
}
